# ====================================================================
# HB+ Fit Cross-Platform Authentication - Environment Configuration
# ====================================================================
# Copy this file to .env and fill in your Firebase & OAuth credentials.
# On Netlify, add these under: Site Configuration > Environment Variables.
# All client-accessible variables in Expo Web MUST be prefixed with EXPO_PUBLIC_

# --------------------------------------------------------------------
# 1. Firebase Web Configuration
# Obtained from: Firebase Console > Project Settings > General > Your apps
# --------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# --------------------------------------------------------------------
# 2. Domain Enforcement Policy
# Only email addresses ending with this domain are authorized to log in.
# Default requirement: @hbplus.fit
# --------------------------------------------------------------------
EXPO_PUBLIC_ALLOWED_DOMAIN=@hbplus.fit

# --------------------------------------------------------------------
# 3. Google OAuth 2.0 Client IDs
# Obtained from: Google Cloud Console > APIs & Services > Credentials
# --------------------------------------------------------------------
# Web OAuth Client ID (mandatory for React Native Web & Netlify deployment)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional Native OAuth Client IDs (for standalone iOS / Android native binaries)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# --------------------------------------------------------------------
# 4. Initial Role Assignment
# Comma-separated list of @hbplus.fit email addresses granted the Admin role.
# All other @hbplus.fit accounts will be assigned the User role.
# --------------------------------------------------------------------
EXPO_PUBLIC_INITIAL_ADMIN_EMAILS=admin@hbplus.fit,lead@hbplus.fit
